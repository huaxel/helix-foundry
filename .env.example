# Run scripts/setup.sh to generate secrets. Do not use example values.
ENCRYPTION_KEY=
INTERNAL_KEY=
APP_ORIGIN=http://localhost:5173
HELIX_URL=http://127.0.0.1:6996
EXECUTOR_URL=http://127.0.0.1:3002
MODEL_ENDPOINT=http://framearch-juan:8000/v1
DATA_DIR=.data
# Compose: the browser origin. There is no sign-in, so keep it on this computer.
PUBLIC_ORIGIN=http://localhost:3001
PUBLIC_PORT=3001
# Tailscale + password architecture: set a strong password to require sign-in
# for browser and API access, point the origin at this machine's Tailscale
# address, and set TAILSCALE_IP so Compose publishes the app on the tailnet
# (loopback stays published for healthchecks). The app refuses non-loopback
# origins without AUTH_PASSWORD. Example:
# AUTH_PASSWORD=choose-a-strong-password-here
# PUBLIC_ORIGIN=http://100.81.226.52:3001
# TAILSCALE_IP=100.81.226.52
# Optional executor overrides; the Compose defaults are sized for a small machine.
# EXECUTOR_CONCURRENCY=1
# DUCKDB_MEMORY=768MB
# DUCKDB_THREADS=1
# DUCKDB_TEMP_LIMIT=2GB
# DUCKDB_TEMP_DIR=/tmp
# Local Parquet connector: only matching paths appear in the import picker.
# LOCAL_DATA_INCLUDE=**/*.parquet
# Optional provider sign-in. Register each integration and its workspace callback URL.
# See docs/HOSTING.md. Leave blank to use provider API keys or direct connections.
NEON_CLIENT_ID=
NEON_CLIENT_SECRET=
SUPABASE_CLIENT_ID=
SUPABASE_CLIENT_SECRET=
PLANETSCALE_CLIENT_ID=
PLANETSCALE_CLIENT_SECRET=
